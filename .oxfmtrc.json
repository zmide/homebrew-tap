{
	"useTabs": true,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": true,
	"printWidth": 180,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSameLine": true,
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"web/.generated/**",
		"web/.nuxt/**",
		"web/.output/**",
		"web/dist/**",
		"web/test-results/**",
		"web/playwright-report/**",
		"web/styles/registry.css"
	]
}
